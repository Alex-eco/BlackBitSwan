{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "bundled:market-risk",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "permissions": [],
  "tags": ["AI", "crypto", "risk", "sentiment", "market-intelligence"],
  "system_prompt_addendum": "Blackbitswan eAI provides market-risk intelligence. Treat its risk scan as analytical information, not personalized financial advice or a guaranteed prediction.",
  "user_message_prefix_template": "[Blackbitswan eAI] {user_message}",
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": ["https://blackbitswan.onrender.com"]
    },
    "views": [
      {
        "name": "main",
        "title": "Blackbitswan eAI",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 360, "h": 520 },
        "default_size": { "w": 560, "h": 720 },
        "max_size": { "w": 900, "h": 1100 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:bundled:market-risk"],
      "chat": ["write_message"],
      "artifact": [],
      "llm": [],
      "fs": [],
      "storage": [],
      "prefs": [],
      "window": ["set_title"]
    },
    "csp_overrides": {
      "connect-src": ["'self'", "https://blackbitswan.onrender.com"],
      "img-src": ["'self'", "data:", "blob:"],
      "font-src": ["'self'", "data:"],
      "style-src": ["'self'", "'unsafe-inline'"],
      "script-src": ["'self'"]
    }
  }
}
